# Copy to backend/.env (ignored by git) and fill in. Spring reads it when started from backend/ or the repo root.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_platform
DB_USER=
DB_PASSWORD=

# At least 32 characters. Keeps logins valid across restarts. Generate one with: openssl rand -hex 32
AUTH_LOCAL_SECRET=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Print every SQL statement (development only)
SHOW_SQL=false

# Optional: owner booking emails through Resend
RESEND_API_KEY=
